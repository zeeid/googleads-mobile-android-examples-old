<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="MergeRootFrame">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Package Name Disini"
            android:textStyle="bold|italic"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/AdvertisingId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AdvertisingId Disini"
            android:textStyle="bold|italic"
            android:layout_below="@+id/textView"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/buttoninata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/AdvertisingId"
            android:text="Penyegaran Inata Room"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/buttoninatamedatio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/buttoninata"
            android:text="Medatio Inata Room"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/buttonhadiahroom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/buttoninatamedatio"
            android:text="Hadiah Room"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/buttonRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/buttonhadiahroom"
            android:layout_centerHorizontal="true"

            android:text="Refresh"
            tools:ignore="HardcodedText" />


        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/buttonRefresh"
            android:text="DATA IP USER"
            tools:ignore="HardcodedText" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/darkModeButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_above="@id/floatingActionButton"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Dark Mode"
            android:elevation="1dp"
            android:src="@drawable/ic_dark_mode"
            app:backgroundTint="#00FFFFFF"
            app:maxImageSize="55dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floatingActionButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="FloatingBtn"
            android:elevation="1dp"
            android:src="@drawable/ic_add"
            app:backgroundTint="#00FFFFFF"
            app:maxImageSize="55dp" />

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
