<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface"
    tools:ignore="MergeRootFrame">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Package Name Disini"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold|italic"
            android:textColor="@color/colorPrimaryText"
            android:layout_marginBottom="@dimen/spacing_large"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/buttonRefresh"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="Refresh"
            android:textColor="@color/colorAccentText"
            android:backgroundTint="@color/colorPrimary"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/buttonSyncAccount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="Sync Data Account"
            android:textColor="@color/colorAccentText"
            android:backgroundTint="@color/infoBlue"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonMiniGame"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="Mini Game"
            android:textColor="@color/colorAccentText"
            android:backgroundTint="@color/successGreen"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATA IP USER"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryText"
            android:layout_marginBottom="@dimen/spacing_medium"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detail checking .."
            android:textSize="@dimen/text_size_medium"
            android:textColor="@color/colorSecondaryText"
            android:background="@color/cardBackground"
            android:padding="@dimen/spacing_medium"
            android:elevation="4dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
